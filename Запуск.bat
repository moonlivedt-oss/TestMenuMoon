@echo off
REM Запуск Test Menu Studio (GUI тулкита TestMenuMoon, PyQt6).
REM PyQt6 и прочие зависимости стоят в Python 3.14 — целимся туда явно через
REM py-лаунчер. Обычный `python` из PATH сейчас = 3.11 (без зависимостей).
REM Консоль оставлена видимой намеренно: если что-то не так, ошибка будет на экране.
cd /d "%~dp0"
py -3.14 "studio.py"
REM Без паузы окно закрывалось сразу, и текст ошибки было не прочитать.
if errorlevel 1 pause
